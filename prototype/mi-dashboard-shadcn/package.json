{
  "name": "mi-dashboard-shadcn",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --experimental-strip-types scripts/build-editorial-defaults.mjs && tsc -b && vite build && node scripts/build-weekly-html.mjs",
    "data:update": "node --experimental-strip-types scripts/update-dashboard-data.mjs && node --experimental-strip-types scripts/build-editorial-defaults.mjs",
    "data:check": "node --experimental-strip-types scripts/update-dashboard-data.mjs prototype/mi-dashboard-shadcn/src/data/dashboard.json --check",
    "test": "node --experimental-strip-types scripts/check-production.mjs && node --experimental-strip-types scripts/check-hover-details.mjs && node --experimental-strip-types scripts/check-chart-selection.mjs && node --experimental-strip-types scripts/check-editorial-defaults.mjs && node scripts/check-weekly-html.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.6",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
